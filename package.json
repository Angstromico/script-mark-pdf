{
  "name": "script-mark-pdf",
  "version": "1.0.0",
  "description": "A TypeScript app to turn markdown files into PDFs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "md-to-word": "node dist/md-to-word.js",
    "dev:md-to-word": "ts-node src/md-to-word.ts",
    "md-to-docs": "node dist/md-to-docs.js",
    "dev:md-to-docs": "ts-node src/md-to-docs.ts",
    "pdf-to-md": "node dist/pdf-to-md.js",
    "dev:pdf-to-md": "ts-node src/pdf-to-md.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "markdown",
    "pdf",
    "typescript"
  ],
  "author": "Manuel Morales",
  "license": "ISC",
  "dependencies": {
    "@types/marked": "^5.0.2",
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "docx": "^9.6.1",
    "fs-extra": "^11.2.0",
    "marked": "^18.0.2",
    "md-to-pdf": "^5.2.4",
    "pdfjs-dist": "^3.11.174",
    "puppeteer": "^21.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  }
}
